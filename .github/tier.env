# Tier metadata consumed by CI scripts and Helm defaults.
TIER_SLUG=tier-analytics
INSTALLATION_TIER=TIER_2_ANALYTICS
SPRING_PROFILES=docker,tier-analytics
IMAGE_PREFIX=retrysight/tier-analytics

POSTGRES_DB=agent_retry_analytics
